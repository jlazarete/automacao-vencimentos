# Copie este arquivo para .env e preencha. O .env NUNCA deve ser versionado.
# Todos os valores abaixo são apenas placeholders.

# Credenciais do Dropbox
DROPBOX_REFRESH_TOKEN=seu_refresh_token_aqui
DROPBOX_APP_KEY=sua_app_key_aqui
DROPBOX_APP_SECRET=seu_app_secret_aqui

# Credenciais de envio de e-mail (Gmail com senha de aplicativo)
EMAIL_USER=seu_email_gestor@exemplo.com
EMAIL_PASS=sua_senha_de_aplicativo_do_gmail_aqui

# Opcionais (padrões: 20 dias de antecedência e pasta raiz do Dropbox)
DIAS_ANTECEDENCIA=20
DROPBOX_PASTA=
